<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog đổi địa chỉ server — nâng cấp giao diện theo design system chung
     (bg_surface_card, bg_input_field, bg_button_primary/outline, spacing_*, font Kanit).
     UI-only, KHÔNG đổi logic. Giữ nguyên id ServerAddressDialogFragment.kt đang findViewById:
     editServer, btnSave, btnCancel, tvHint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="@dimen/spacing_lg"
    android:orientation="vertical"
    android:background="@drawable/bg_surface_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvTitle"
        android:text="@string/dialog_server_title"
        android:fontFamily="@font/kanit_bold"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/editServer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_input_field"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:hint="@string/server_hint_url"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:fontFamily="@font/kanit_regular"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:minHeight="48dp"
        tools:ignore="VisualLintTextFieldSize" />

    <TextView
        android:id="@+id/tvHint"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/server_help_text"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_marginTop="@dimen/spacing_md"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnCancel"
            android:text="@string/action_cancel"
            android:background="@drawable/bg_button_outline"
            android:textColor="@color/primary"
            android:fontFamily="@font/kanit_medium"
            android:textAllCaps="false"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:minWidth="0dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp" />

        <Space
            android:layout_width="@dimen/spacing_sm"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnSave"
            android:text="@string/action_save"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/white"
            android:fontFamily="@font/kanit_medium"
            android:textAllCaps="false"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:minWidth="0dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp" />
    </LinearLayout>
</LinearLayout>
