<?xml version="1.0" encoding="utf-8"?>
<!-- Item danh sách đặt bàn trước (ReservationAdapter) — mirror style thẻ của item_table.xml,
     thêm badge trạng thái + nút Huỷ. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_sm">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTableLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/kanit_bold"
                android:text="Bàn 5"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_ready"
                android:fontFamily="@font/kanit_medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="CONFIRMED"
                android:textColor="@color/chip_ready_text"
                android:textSize="11sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCustomerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="@font/kanit_regular"
            android:text="Nguyễn Văn A • 0901234567"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvPartyAndTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/kanit_regular"
            android:text="4 khách • 19:30 28/08/2026"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/kanit_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:text="Huỷ đặt bàn"
            android:textColor="@color/accent_danger"
            android:textSize="13sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.cardview.widget.CardView>
