<?xml version="1.0" encoding="utf-8"?>
<!-- Item trong danh sách quản lý bàn (TableAdapter) — id tvTableName giữ nguyên, chỉ đổi style
     sang card bo góc/elevation theo design token thay vì pill trắng phẳng cũ. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_sm"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_sm">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTableName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/kanit_bold"
        android:gravity="center"
        android:padding="@dimen/spacing_md"
        android:text="Table VIP 1"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

</androidx.cardview.widget.CardView>
