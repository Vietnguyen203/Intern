<?xml version="1.0" encoding="utf-8"?>
<!-- Layout preview riêng cho trạng thái "đang có khách" (không có id nào Kotlin bind tới — chỉ
     dùng làm tools:listitem xem trước trong fragment_dashboard.xml; runtime thực tế dùng chung
     item_table_view.xml + đổi background động trong TableDashboardAdapter). Style đồng bộ với
     item_table_view.xml để bản xem trước khớp với lúc chạy thật. -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:background="@drawable/bg_surface_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_sm">

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:fontFamily="@font/kanit_medium"
        android:text="Table 1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_occupied_table_view"
        android:fontFamily="@font/kanit_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Occupied"
        android:textColor="@color/chip_pending_text"
        android:textSize="15sp" />
</androidx.appcompat.widget.LinearLayoutCompat>
