<?xml version="1.0" encoding="utf-8"?>
<!-- Màn chi tiết bàn (Order Table) — nâng cấp theo design system chung (bg_app, primary, radius,
     spacing, bg_surface_card, bg_button_primary/outline). Không đổi id nào OrderTableFragment.kt
     đang dùng: cardViewBack, tvTableName, tvWaiter, tvCreateAt, cardOrder, cardCopyOrder,
     recyclerView, tvTotalAmount, btnCancel, btnCompleted, loadingView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="@dimen/radius_pill"
            app:cardElevation="@dimen/elevation_sm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="13dp"
                app:srcCompat="@drawable/baseline_arrow_back_ios_new_24"
                app:tint="@color/primary" />
        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTableName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:fontFamily="@font/kanit_extra_bold"
            android:includeFontPadding="false"
            android:textColor="@color/primary"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/cardViewBack"
            app:layout_constraintStart_toEndOf="@id/cardViewBack"
            app:layout_constraintTop_toTopOf="@id/cardViewBack" />

        <!-- Meta card: gộp Waiter + Create at vào 1 khối bg_surface_card thay vì text trần trên nền trắng -->
        <LinearLayout
            android:id="@+id/llTableMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:background="@drawable/bg_surface_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardViewBack">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv01"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit_regular"
                    android:text="Waiter: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWaiter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv02"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit_regular"
                    android:text="Create at: "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvCreateAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/kanit_medium"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CTA gọi thêm món / copy đơn sang bàn khác — pill button dùng bg_button_primary/outline
             thay CardView bọc text (đồng bộ với các màn đã nâng cấp: fragment_staff…) -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cardOrder"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/kanit_extra_bold"
            android:gravity="center"
            android:text="+ Order"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/cardCopyOrder"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llTableMeta" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cardCopyOrder"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/bg_button_outline"
            android:fontFamily="@font/kanit_extra_bold"
            android:gravity="center"
            android:text="Copy Order"
            android:textColor="@color/primary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardOrder"
            app:layout_constraintTop_toTopOf="@id/cardOrder" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            app:layout_constraintBottom_toTopOf="@id/btnConfirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardOrder"
            tools:listitem="@layout/item_order_food" />

        <!-- Xác nhận đặt món: PENDING -> CONFIRMED + đẩy tất cả món sang COOKING (bếp bắt đầu nấu
             ngay). Chỉ hiện khi đơn đang PENDING — OrderTableFragment.kt tự ẩn/hiện theo order.status. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:visibility="gone"
            app:cardBackgroundColor="@color/accent_ready"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="@dimen/elevation_sm"
            app:layout_constraintBottom_toTopOf="@id/llTotalBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recyclerView"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/kanit_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="✅ Xác nhận đặt món"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </androidx.cardview.widget.CardView>

        <!-- Thanh tổng tiền — tách khỏi vùng list bằng bg_surface_card + border trên để rõ ranh giới -->
        <LinearLayout
            android:id="@+id/llTotalBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            app:layout_constraintBottom_toTopOf="@id/btnCancel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv03"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/kanit_regular"
                android:text="Total: "
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/kanit_extra_bold"
                android:gravity="end"
                android:text="123123"
                android:textColor="@color/primary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Huỷ đơn: hành động phá huỷ nhưng phụ — chuyển sang outline đỏ để "Thanh toán" nổi bật
             hơn là CTA chính (đổi cảm nhận thị giác, KHÔNG đổi id/click handler/luồng xử lý). -->
        <!-- MaterialCardView (thay CardView thường) để dùng được strokeColor/strokeWidth cho viền đỏ;
             tương thích ngược 100% với setOnClickListener mà OrderTableFragment.kt đang gắn lên id này. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCompleted"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="@color/accent_danger"
            app:strokeWidth="1.5dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/kanit_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="cancel"
                android:textAllCaps="true"
                android:textColor="@color/accent_danger" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCompleted"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/spacing_xs"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="@dimen/elevation_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCancel">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/kanit_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="completed"
                android:textAllCaps="true"
                android:textColor="@android:color/white" />
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.food.order.utils.widget.FoodOrderLoadingView
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true" />
</FrameLayout>
