<?xml version="1.0" encoding="utf-8"?>
<!-- Màn Cài đặt — nâng cấp giao diện theo design system chung (bg_app, bg_surface_card,
     spacing_*/radius_*, font Kanit). UI-only, KHÔNG đổi logic/text nội dung.
     Giữ nguyên toàn bộ id mà SettingsFragment.kt đang dùng (grep "binding." đã kiểm tra):
     btnBack, switchDarkMode, rowDarkMode, switchSound, rowSound, tvSoundDesc, langToggleGroup,
     btnVI, btnEN, tvLangDesc, tvSystemTitle, cardSystem, rowServer, tvServerUrl. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_md"
            android:background="@color/bg_surface"
            android:elevation="@dimen/elevation_sm">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/baseline_arrow_back_ios_new_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="13dp"
                android:tint="@color/primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textSize="20sp"
                android:fontFamily="@font/kanit_bold"
                android:textColor="@color/text_primary"
                android:paddingStart="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- Content Cards -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Section: Tùy chỉnh ứng dụng -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_app_prefs_title"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:fontFamily="@font/kanit_medium"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_sm"
                android:paddingStart="@dimen/spacing_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card">

                <!-- Row: Dark Mode -->
                <LinearLayout
                    android:id="@+id/rowDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dark_mode"
                        android:textSize="15sp"
                        android:fontFamily="@font/kanit_medium"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@color/border_color" />

                <!-- Row: Sound Notification -->
                <LinearLayout
                    android:id="@+id/rowSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_notification"
                            android:textSize="15sp"
                            android:fontFamily="@font/kanit_medium"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvSoundDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sound_notification_desc_on"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:background="@color/border_color" />

                <!-- Row: Language -->
                <LinearLayout
                    android:id="@+id/rowLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/language"
                            android:textSize="15sp"
                            android:fontFamily="@font/kanit_medium"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvLangDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tiếng Việt"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Language pill buttons -->
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/langToggleGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVI"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="VI"
                            android:textSize="13sp"
                            android:fontFamily="@font/kanit_medium"
                            android:textColor="@color/primary"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            app:strokeColor="@color/primary"
                            app:rippleColor="@color/primary_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEN"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="EN"
                            android:textSize="13sp"
                            android:fontFamily="@font/kanit_medium"
                            android:textColor="@color/primary"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            app:strokeColor="@color/primary"
                            app:rippleColor="@color/primary_light" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Section: Hệ thống (chỉ ADMIN thấy) -->
            <TextView
                android:id="@+id/tvSystemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_system_title"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:fontFamily="@font/kanit_medium"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_sm"
                android:paddingStart="@dimen/spacing_xs" />

            <LinearLayout
                android:id="@+id/cardSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card">

                <!-- Row: Server Address -->
                <LinearLayout
                    android:id="@+id/rowServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/server_address"
                            android:textSize="15sp"
                            android:fontFamily="@font/kanit_medium"
                            android:textColor="@color/text_primary" />

                        <!-- Giá trị hiện tại hiển thị dạng chip (bg_chip_neutral), thay cho text trơn -->
                        <TextView
                            android:id="@+id/tvServerUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_chip_neutral"
                            android:text="Nhấn để thay đổi địa chỉ"
                            android:textSize="11sp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="@dimen/spacing_sm"
                            android:paddingEnd="@dimen/spacing_sm"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/chip_neutral_text" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/baseline_arrow_back_ios_new_24"
                        android:rotation="180"
                        android:contentDescription="Go"
                        app:tint="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
