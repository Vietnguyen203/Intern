<?xml version="1.0" encoding="utf-8"?>
<!-- Form sửa nhân viên — nâng cấp theo design system, bọc NestedScrollView (mirror pattern
     fragment_create_table.xml: FrameLayout > NestedScrollView + loadingView phủ toàn màn hình).
     Không đổi id nào UpdateStaffFragment.kt đang dùng: cardViewBack, edtEmployeeId, edtPassword,
     edtDisplayName, edtEmail, edtPhoneNumber, tvBirthdayValue, radioGroupGender, rbMale, rbFemale,
     radioGroupRole, rbWaiter, rbKitchen, rbAdmin, btnUpdate, btnRemove, loadingView. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="13dp"
                    app:srcCompat="@drawable/baseline_arrow_back_ios_new_24"
                    app:tint="@color/primary" />
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/kanit_extra_bold"
                android:includeFontPadding="false"
                android:text="Edit staff"
                android:textColor="@color/primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/cardViewBack"
                app:layout_constraintStart_toEndOf="@id/cardViewBack"
                app:layout_constraintTop_toTopOf="@id/cardViewBack" />

            <!-- Card: thông tin đăng nhập -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardViewBack">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_bold"
                        android:text="Thông tin đăng nhập"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEmployeeId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Employee ID"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEmployeeId"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:enabled="false"
                        android:fontFamily="@font/kanit_regular"
                        android:inputType="text"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:textColor="@color/text_secondary" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Password"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: thông tin cá nhân -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPersonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAccount">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_bold"
                        android:text="Thông tin cá nhân"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvDisplayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Display name"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtDisplayName"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:inputType="text"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:textColor="@color/text_primary" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Email"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:hint="example@email.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPhoneNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Phone number"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPhoneNumber"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:hint="0xxxxxxxxx"
                        android:inputType="phone"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvBirthday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Birthday"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvBirthdayValue"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_birthday"
                        android:drawablePadding="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_regular"
                        android:gravity="center_vertical"
                        android:hint="yyyy-MM-dd"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/kanit_extra_light"
                        android:text="Gender"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/radioGroupGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbMale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:fontFamily="@font/kanit_regular"
                            android:gravity="center"
                            android:text="Nam"
                            android:textColor="@color/primary" />

                        <RadioButton
                            android:id="@+id/rbFemale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kanit_regular"
                            android:gravity="center"
                            android:text="Nữ"
                            android:textColor="@color/primary" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card: vai trò -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPersonal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_bold"
                        android:text="Role"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <RadioGroup
                        android:id="@+id/radioGroupRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbWaiter"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:fontFamily="@font/kanit_regular"
                            android:gravity="center"
                            android:text="WAITER"
                            android:textColor="@color/primary" />

                        <RadioButton
                            android:id="@+id/rbKitchen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kanit_regular"
                            android:gravity="center"
                            android:text="KITCHEN"
                            android:textColor="@color/primary" />

                        <RadioButton
                            android:id="@+id/rbAdmin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/kanit_regular"
                            android:gravity="center"
                            android:text="ADMIN"
                            android:textColor="@color/primary" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hàng nút hành động: Remove (đỏ) + Update (navy) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnRemove"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/accent_danger"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnUpdate"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardRole"
                app:layout_constraintWidth_percent="0.44">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/kanit_extra_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="remove"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnUpdate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnRemove"
                app:layout_constraintTop_toBottomOf="@id/cardRole">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/kanit_extra_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="update"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.food.order.utils.widget.FoodOrderLoadingView
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true" />
</FrameLayout>
