<?xml version="1.0" encoding="utf-8"?>
<!-- Item nguyên liệu trong danh sách kho — nâng cấp theo design system (card bo góc lớn, avatar icon
     tròn, trạng thái hiển thị dạng badge pill). Không đổi id nào InventoryAdapter.kt đang dùng:
     ivIcon, tvName, tvStatus, tvStock, tvUnit. Lưu ý: InventoryAdapter set màu chữ tvStatus/tvStock
     và tint ivIcon bằng code (Color.parseColor #EF4444 / #10B981 tuỳ mức tồn kho) — phần này KHÔNG
     đổi vì không được sửa .kt. Badge tvStatus dùng nền pill trung tính (bg_chip_neutral) làm khung
     chung, màu chữ đỏ/xanh do code set sẽ tự nổi bật bên trong khung — tương đương ý nghĩa
     bg_chip_urgent/accent_danger (thấp) và bg_chip_ready/accent_ready (đủ) nhưng không thể đổi màu
     NỀN badge theo từng trạng thái vì nền là cố định trong layout còn màu do code set động. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_sm">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_md">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardIconWrapper"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/primary_light"
            app:cardCornerRadius="@dimen/radius_pill"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/icon_food_menu_v2"
                app:tint="@color/primary" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:ellipsize="end"
            android:fontFamily="@font/kanit_bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/tvStock"
            app:layout_constraintStart_toEndOf="@+id/cardIconWrapper"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Thịt bò" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_chip_neutral"
            android:fontFamily="@font/kanit_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/tvName"
            app:layout_constraintTop_toBottomOf="@+id/tvName"
            tools:text="Tình trạng: Tốt" />

        <TextView
            android:id="@+id/tvStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit_bold"
            android:textColor="@color/primary"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="10.5" />

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/kanit_regular"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvStock"
            app:layout_constraintStart_toEndOf="@+id/tvStock"
            tools:text="kg" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
