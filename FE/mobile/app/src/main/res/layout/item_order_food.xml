<?xml version="1.0" encoding="utf-8"?>
<!-- Item món trong giỏ order của bàn (OrderTableFragment recyclerView) — nâng cấp theo design
     system chung. Không đổi id nào OrderFoodAdapter.kt đang dùng: ivFood, tvFoodName, tvQuantity,
     tvAmount. cardViewAvatar giữ nguyên id dù không bind trong Kotlin để tránh rủi ro thừa. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginVertical="@dimen/spacing_xs"
    android:background="@drawable/bg_surface_card"
    android:padding="@dimen/spacing_sm">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewAvatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardBackgroundColor="@color/bg_app"
        app:cardCornerRadius="@dimen/radius_pill"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivFood"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/placeholder" />
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFoodName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:ellipsize="end"
        android:fontFamily="@font/kanit_medium"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Gỏi gà xé phay"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/tvQuantity"
        app:layout_constraintStart_toEndOf="@id/cardViewAvatar"
        app:layout_constraintTop_toTopOf="@id/cardViewAvatar"
        app:layout_constraintBottom_toBottomOf="@id/cardViewAvatar"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Badge số lượng — chuyển sang pill nền chip_neutral thay vì số trần cạnh tên món -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/bg_chip_neutral"
        android:fontFamily="@font/kanit_bold"
        android:gravity="center"
        android:minWidth="28dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="10"
        android:textColor="@color/chip_neutral_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/tvAmount"
        app:layout_constraintTop_toTopOf="@id/tvFoodName"
        app:layout_constraintBottom_toBottomOf="@id/tvFoodName" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/kanit_bold"
        android:gravity="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="100000"
        android:textColor="@color/primary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvFoodName"
        app:layout_constraintBottom_toBottomOf="@id/tvFoodName" />

</androidx.constraintlayout.widget.ConstraintLayout>
