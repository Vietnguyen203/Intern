<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_scaffold">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="13dp"
                    app:srcCompat="@drawable/baseline_arrow_back_ios_new_24"
                    app:tint="@color/primary" />
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/kanit_extra_bold"
                android:includeFontPadding="false"
                android:text="Create food"
                android:textColor="@color/primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/cardViewBack"
                app:layout_constraintStart_toEndOf="@id/cardViewBack"
                app:layout_constraintTop_toTopOf="@id/cardViewBack" />

            <!-- Ảnh món — căn giữa thay vì lệch phải, thêm viền + gợi ý chạm để chọn ảnh -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_app"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardViewBack">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivFoodImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/placeholder" />
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSelectImageHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="@font/kanit_light"
                android:text="Nhấn vào ảnh để chọn"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@id/cardViewAvatar"
                app:layout_constraintStart_toStartOf="@id/cardViewAvatar"
                app:layout_constraintTop_toBottomOf="@id/cardViewAvatar" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:fontFamily="@font/kanit_medium"
                android:text="Name"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSelectImageHint" />

            <EditText
                android:id="@+id/edtName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/kanit_regular"
                android:hint="Gà cháy tỏi"
                android:inputType="text"
                android:paddingHorizontal="@dimen/spacing_md"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvName" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/kanit_medium"
                android:text="Price"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtName" />

            <EditText
                android:id="@+id/edtPrice"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginEnd="130dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/kanit_regular"
                android:hint="20000000"
                android:inputType="number"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="30dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPrice" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:fontFamily="@font/kanit_medium"
                android:includeFontPadding="false"
                android:text="VNĐ"
                android:textColor="@color/text_secondary"
                app:layout_constraintBottom_toBottomOf="@id/edtPrice"
                app:layout_constraintEnd_toEndOf="@id/edtPrice"
                app:layout_constraintTop_toTopOf="@id/edtPrice" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:fontFamily="@font/kanit_medium"
                android:text="Unit of measure"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/edtPrice"
                app:layout_constraintTop_toTopOf="@id/tvPrice" />

            <EditText
                android:id="@+id/edtUnit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/kanit_regular"
                android:hint="Đĩa, Suất..."
                android:inputType="text"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/edtPrice"
                app:layout_constraintTop_toBottomOf="@id/tvUnit" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/kanit_medium"
                android:text="Food Category"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtUnit" />

            <RadioGroup
                android:id="@+id/radioGroupCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xs"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCategory">

                <RadioButton
                    android:id="@+id/rbMainCourse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:checked="true"
                    android:buttonTint="@color/primary"
                    android:fontFamily="@font/kanit_regular"
                    android:gravity="start|center_vertical"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="0dp"
                    android:text="MAIN COURSE"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbAppetizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:buttonTint="@color/primary"
                    android:fontFamily="@font/kanit_regular"
                    android:gravity="start|center_vertical"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="0dp"
                    android:text="APPETIZER"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDessert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:buttonTint="@color/primary"
                    android:fontFamily="@font/kanit_regular"
                    android:gravity="start|center_vertical"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="0dp"
                    android:text="DESSERT"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbBeverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:buttonTint="@color/primary"
                    android:fontFamily="@font/kanit_regular"
                    android:gravity="start|center_vertical"
                    android:paddingStart="@dimen/spacing_xs"
                    android:paddingEnd="0dp"
                    android:text="BEVERAGE"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/kanit_regular"
                android:gravity="start|top"
                android:hint="Description"
                android:inputType="textMultiLine"
                android:padding="@dimen/spacing_sm"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/radioGroupCategory" />

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCreate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/edtDescription">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/kanit_extra_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="create"
                    android:textAllCaps="true"
                    android:textColor="@color/white" />
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.food.order.utils.widget.FoodOrderLoadingView
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true" />
</FrameLayout>
