<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard (màn chính sau đăng nhập) — nâng cấp giao diện theo design system chung
     (bg_app nền màn hình, card trắng bo góc viền mảnh, chip pill, ripple trên nút).
     Chỉ đổi giao diện, KHÔNG đổi id/logic — mọi id đang bind qua FragmentDashboardBinding
     được giữ nguyên. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_scaffold"
    tools:context=".ui.dashboard.DashboardFragment">

    <!-- Nút mở menu hệ thống — nền chip tròn nhạt phía sau icon để dễ nhận biết vùng chạm -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_lg"
        android:padding="9dp"
        android:background="@drawable/bg_chip_neutral"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:elevation="8dp"
        android:translationZ="8dp"
        android:contentDescription="@string/menu_server"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_menu_24"
        app:tint="@color/primary" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:text="@string/title_dashboard"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:includeFontPadding="false"
        android:fontFamily="@font/kanit_extra_bold"
        app:layout_constraintStart_toEndOf="@id/ivMenu"
        app:layout_constraintTop_toTopOf="@id/ivMenu"
        app:layout_constraintBottom_toBottomOf="@id/ivMenu" />

    <!-- Card thông tin nhân viên — card trắng bo góc viền mảnh, mirror bg_surface_card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_sm"
        app:strokeColor="@color/border_color"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDashboard">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Employee ID -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Employee ID"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:fontFamily="@font/kanit_extra_light" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvEmployeeId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:fontFamily="@font/kanit_extra_bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:background="@color/border_color" />

            <!-- Name -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:fontFamily="@font/kanit_extra_light" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Nguyen Van A"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:fontFamily="@font/kanit_extra_bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:background="@color/border_color" />

            <!-- Birthday -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Birthday"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:fontFamily="@font/kanit_extra_light" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBirthday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="2000-01-01"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:drawableStart="@drawable/ic_birthday"
                    android:drawablePadding="8dp"
                    app:drawableTint="@color/primary"
                    android:fontFamily="@font/kanit_extra_bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- dòng Role đã xoá -->
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>

    <!-- Grid menu điều hướng — hiện đang bị ẩn ở runtime (đã chuyển sang SystemMenuDialog),
         giữ nguyên id/adapter binding, chỉ cập nhật spacing cho khớp token khi cần hiện lại. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_xs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardViewInfo"
        tools:itemCount="6"
        tools:listitem="@layout/item_dashboard_menu" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTableList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="Table list"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/kanit_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvMenu" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_xs"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTableList"
        app:layout_constraintBottom_toTopOf="@id/cardViewDashboard"
        tools:itemCount="10"
        tools:listitem="@layout/item_occupied_table_view" />

    <!-- Thanh tổng hợp cuối màn — hai chỉ số dạng chip pill, mirror stat tile bên Web Overview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="@dimen/elevation_lg"
        app:strokeColor="@color/border_color"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/spacing_xs">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Total number of tables:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/kanit_light" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTotalTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="10"
                    android:textColor="@color/chip_neutral_text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_chip_neutral"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="2dp"
                    android:minWidth="32dp"
                    android:gravity="center"
                    android:fontFamily="@font/kanit_extra_bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:background="@color/border_color" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_xs">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Which is being used:"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/kanit_light" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTotalUseTable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_primary"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="2dp"
                    android:minWidth="32dp"
                    android:gravity="center"
                    android:fontFamily="@font/kanit_extra_bold" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
