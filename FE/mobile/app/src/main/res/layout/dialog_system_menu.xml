<?xml version="1.0" encoding="utf-8"?>
<!-- Card ngoài cùng của menu hệ thống — dùng token bg_surface/radius_xl/elevation_lg thay vì
     hardcode, chỉ chỉnh khung/khoảng cách bao ngoài, KHÔNG đổi cấu trúc bên trong
     SystemMenuView (custom view riêng, xem utils/widget/SystemMenuView.kt). -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_xl"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="@dimen/radius_xl"
    app:cardElevation="@dimen/elevation_lg">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="@dimen/spacing_sm">

        <!-- Row 1 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewDashboard"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_dashboard"
                app:titleText="Dashboard" />

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewFoodMenu"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_food_menu_v2"
                app:titleText="Food Menu" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 2 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewOrderManagement"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_order_manager"
                app:titleText="Order Management" />

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewTables"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_tables"
                app:titleText="Tables" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 3 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewStaff"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_staff"
                app:titleText="Staff" />

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewReport"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_analysis"
                app:titleText="Reports" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 4 (NEW): Kitchen + Logout -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewKitchen"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_food_menu_v2"
                app:titleText="Kitchen Console" />

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewLogout"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@android:drawable/ic_menu_close_clear_cancel"
                app:titleText="Logout" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 5: Settings -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewSettings"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@android:drawable/ic_menu_manage"
                app:titleText="Settings" />

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewInventory"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/icon_food_menu_v2"
                app:titleText="Inventory" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Row 6: Profile (màn Hồ sơ cá nhân — trước đây có layout sẵn nhưng "mồ côi", không có
             lối vào nào) -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:orientation="horizontal">

            <com.food.order.utils.widget.SystemMenuView
                android:id="@+id/menuViewProfile"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                app:iconSrc="@drawable/ic_profile"
                app:titleText="Hồ sơ cá nhân" />

            <View
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.cardview.widget.CardView>
