<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog tuỳ chọn món (số lượng, tuỳ chọn, ghi chú) — nâng cấp theo design system chung, hex màu
     rời rạc trước đây đổi sang token trong colors.xml/dimens.xml. Không đổi id nào
     OrderFoodFragment.kt đang findViewById/binding tới: ivFoodDialog, tvFoodName, tvFoodPrice,
     btnMinus, tvQuantity, btnPlus, tvOptionsLabel, llOptionsContainer, etNote, btnCancel, btnAdd. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card chính -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_sm"
            android:layout_marginVertical="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_surface">

                <!-- Ảnh món ăn full-bleed -->
                <ImageView
                    android:id="@+id/ivFoodDialog"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop" />

                <!-- Nội dung -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm">

                    <!-- Tên + Giá -->
                    <TextView
                        android:id="@+id/tvFoodName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tên Món Ăn"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:fontFamily="@font/kanit_bold" />

                    <TextView
                        android:id="@+id/tvFoodPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="100,000 VND"
                        android:textColor="@color/primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/kanit_bold"
                        android:background="@color/primary_light"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:layout_marginBottom="4dp"
                        android:background="@color/border_color" />

                    <!-- Số lượng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Số lượng"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/kanit_medium" />

                        <!-- Quantity Control -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_chip_neutral"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnMinus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="−"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:background="?attr/selectableItemBackgroundBorderless" />

                            <TextView
                                android:id="@+id/tvQuantity"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/kanit_bold" />

                            <TextView
                                android:id="@+id/btnPlus"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:background="?attr/selectableItemBackgroundBorderless" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@color/border_color" />

                    <!-- Tuỳ chọn thêm -->
                    <TextView
                        android:id="@+id/tvOptionsLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Tuỳ chọn thêm"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/kanit_medium" />

                    <LinearLayout
                        android:id="@+id/llOptionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:orientation="vertical" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/divider3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@color/border_color" />

                    <!-- Ghi chú -->
                    <TextView
                        android:id="@+id/tvNoteLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Ghi chú"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/kanit_medium" />

                    <EditText
                        android:id="@+id/etNote"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:gravity="top|start"
                        android:hint="Ví dụ: Ít đá, không hành..."
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <!-- Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnCancel"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:fontFamily="@font/kanit_medium"
                            android:text="Hủy"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/border_color"
                            app:cornerRadius="@dimen/radius_md" />

                        <Button
                            android:id="@+id/btnAdd"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.5"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:backgroundTint="@color/primary"
                            android:fontFamily="@font/kanit_bold"
                            android:text="🛒  Thêm Món"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/radius_md" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
