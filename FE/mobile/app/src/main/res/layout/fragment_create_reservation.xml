<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_scaffold">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="13dp"
                    app:srcCompat="@drawable/baseline_arrow_back_ios_new_24"
                    app:tint="@color/primary" />
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:fontFamily="@font/kanit_extra_bold"
                android:includeFontPadding="false"
                android:text="Đặt bàn mới"
                android:textColor="@color/primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/cardViewBack"
                app:layout_constraintStart_toEndOf="@id/cardViewBack"
                app:layout_constraintTop_toTopOf="@id/cardViewBack" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardForm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/bg_surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardViewBack">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:fontFamily="@font/kanit_medium"
                        android:text="Tên khách"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtCustomerName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:hint="Nguyễn Văn A"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:fontFamily="@font/kanit_medium"
                        android:text="Số điện thoại"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtCustomerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:hint="0901234567"
                        android:inputType="phone"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:fontFamily="@font/kanit_medium"
                        android:text="Số khách"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtPartySize"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="@font/kanit_regular"
                        android:hint="4"
                        android:inputType="number"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:layout_marginBottom="@dimen/spacing_xs"
                        android:fontFamily="@font/kanit_medium"
                        android:text="Ngày &amp; giờ đặt"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPickDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/kanit_regular"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:text="Chọn ngày &amp; giờ"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnFindTables"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/kanit_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Tìm bàn trống"
                android:textColor="@color/primary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardForm" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAvailableTablesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/kanit_medium"
                android:text="Chọn bàn:"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnFindTables" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTables"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_md"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tvAvailableTablesLabel"
                tools:listitem="@layout/item_available_table" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnSubmit"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/kanit_extra_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Xác nhận đặt bàn"
                android:textAllCaps="true"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/recyclerViewTables" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.food.order.utils.widget.FoodOrderLoadingView
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true" />
</FrameLayout>
