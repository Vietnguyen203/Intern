<?xml version="1.0" encoding="utf-8"?>
<!-- Màn quản lý nhân viên — nâng cấp theo design system chung (bg_app, primary, radius, spacing).
     Không đổi id nào StaffFragment.kt đang dùng: cardViewBack, tvStaff, tvAddStaff, recyclerView, loadingView. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".ui.dashboard.DashboardFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_lg"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="@dimen/radius_pill"
        app:cardElevation="@dimen/elevation_sm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="13dp"
            app:srcCompat="@drawable/baseline_arrow_back_ios_new_24"
            app:tint="@color/primary" />
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStaff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:fontFamily="@font/kanit_extra_bold"
        android:includeFontPadding="false"
        android:text="Staff"
        android:textColor="@color/primary"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/cardViewBack"
        app:layout_constraintStart_toEndOf="@id/cardViewBack"
        app:layout_constraintTop_toTopOf="@id/cardViewBack" />

    <!-- Nút thêm nhân viên: giữ id tvAddStaff (StaffFragment gắn click trực tiếp lên ImageView này),
         thêm nền bg_button_primary để có ripple + hình tròn/bo góc thay vì icon trơ trên nền trắng. -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tvAddStaff"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:background="@drawable/bg_button_primary"
        android:padding="9dp"
        app:layout_constraintBottom_toBottomOf="@id/tvStaff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvStaff"
        app:srcCompat="@drawable/baseline_add_24"
        app:tint="@android:color/white" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_md"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStaff"
        app:spanCount="2"
        tools:itemCount="10"
        tools:listitem="@layout/item_staff" />

    <com.food.order.utils.widget.FoodOrderLoadingView
        android:id="@+id/loadingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
