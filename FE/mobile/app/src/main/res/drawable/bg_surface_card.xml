<?xml version="1.0" encoding="utf-8"?>
<!-- Card nền trắng dùng chung cho các khối nội dung (list item, section) — mirror .card bên Web
     (bg-surface + border-color + radius-lg). Dùng làm background cho LinearLayout/ConstraintLayout
     khi không cần bóng đổ của CardView. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/bg_surface" />
    <corners android:radius="@dimen/radius_lg" />
    <stroke
        android:width="1dp"
        android:color="@color/border_color" />
</shape>
