<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules cho Android <12 (Key/Value backup cũ, xem android:fullBackupContent). Loại trừ file
   SharedPreferences chứa JWT (secure_token_prefs.xml, mã hoá bằng EncryptedSharedPreferences — xem
   SessionManager) khỏi backup, cùng lý do với data_extraction_rules.xml.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_token_prefs.xml"/>
</full-backup-content>
