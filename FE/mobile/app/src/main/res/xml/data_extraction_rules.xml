<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules — điều khiển những gì được sao lưu (Cloud backup Android 12+ / chuyển
   thiết bị). Loại trừ tường minh file SharedPreferences chứa JWT (đã mã hoá bằng
   EncryptedSharedPreferences, xem SessionManager.SECURE_PREFS_NAME) — dù đã mã hoá, MasterKey nằm
   trong Android Keystore của THIẾT BỊ GỐC nên bản sao lưu khôi phục trên thiết bị khác cũng không
   đọc được, sao lưu nó chỉ tổ tốn dung lượng vô ích. Xem thêm:
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_token_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_token_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
