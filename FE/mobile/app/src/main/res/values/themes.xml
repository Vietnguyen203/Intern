<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FoodOrder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color — trước đây để màu tím mặc định của Android Studio template,
             khiến các Material component KHÔNG được style riêng (MaterialButton, TabLayout,
             ProgressBar mặc định...) bị lệch tông tím thay vì navy thương hiệu. Đồng bộ về
             @color/primary (mirror biến primary bên Web). -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_hover</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_hover</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
    </style>
</resources>