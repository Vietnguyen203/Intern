<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="202607281002-create-loyalty-accounts-table" author="Vietnguyen203" labels="202607281002">
        <createTable tableName="loyalty_accounts">
            <column name="id" type="VARCHAR2(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="VARCHAR2(36)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_loyalty_accounts_customer"/>
            </column>
            <column name="current_points" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_spent" type="NUMBER(15,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="current_tier_id" type="VARCHAR2(36)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="loyalty_accounts" baseColumnNames="customer_id"
                                  constraintName="fk_loyalty_accounts_customer"
                                  referencedTableName="customers" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="loyalty_accounts" baseColumnNames="current_tier_id"
                                  constraintName="fk_loyalty_accounts_tier"
                                  referencedTableName="membership_tiers" referencedColumnNames="id"/>
        <rollback>
            <dropTable tableName="loyalty_accounts"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
