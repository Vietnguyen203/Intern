    <changeSet id="202607281006-seed-default-membership-tiers" author="Vietnguyen203" labels="202607281006">
        <insert tableName="membership_tiers">
            <column name="id" value="a1000000-0000-0000-0000-000000000001"/>
            <column name="tier_rank" value="BRONZE"/>
            <column name="name" value="Bronze Member"/>
            <column name="min_total_spent" valueNumeric="0"/>
