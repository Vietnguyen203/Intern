            <column name="id" value="a1000000-0000-0000-0000-000000000002"/>
            <column name="tier_rank" value="SILVER"/>
            <column name="name" value="Silver Member"/>
            <column name="min_total_spent" valueNumeric="3000000"/>
            <column name="discount_percent" valueNumeric="3"/>
            <column name="point_multiplier" valueNumeric="1.2"/>
            <column name="color" value="#C0C0C0"/>
